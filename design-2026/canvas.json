  "annotations": [
    { "id": "nota-mapa", "page": "mapa", "x": 0, "y": -150, "w": 620, "text": "COMEÇA AQUI.\nEsta página responde à tua pergunta: olhar para a app e perceber tudo o que ela faz." },
    { "id": "nota-ecras", "page": "ecras", "x": 0, "y": -180, "w": 560, "text": "Os cinco ecrãs, na ordem em que o técnico os usa.\nOs três primeiros são os separadores da barra de baixo.\nOs dois últimos abrem por cima." },
    { "id": "nota-hoje", "page": "ecras", "x": 0, "y": 1680, "w": 390, "text": "Um botão verde e mais nada a competir com ele. As Métricas viraram estes quatro números." },
    { "id": "nota-registos", "page": "ecras", "x": 470, "y": 1780, "w": 390, "text": "Junta o que estava em quatro ecrãs diferentes: Intervenções, Tarefas, Notas e Relatórios." },
    { "id": "nota-estadio", "page": "ecras", "x": 940, "y": 1960, "w": 390, "text": "Junta Áreas do Estádio, Equipamento Instalado e Ferramentas e Stock. Tudo à vista, sem menu." },
    { "id": "nota-nova", "page": "ecras", "x": 1410, "y": 1840, "w": 390, "text": "Três perguntas numeradas. Só a primeira é obrigatória. Os extras estão abertos, não escondidos." },
    { "id": "nota-sistema", "page": "sistema", "x": 0, "y": -150, "w": 620, "text": "Nada aqui é cor nova. São os valores que já existem no theme.css da app." }
  ],
